# Токен бота из Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information -> Application ID)
CLIENT_ID=

# ID сервера (ПКМ по серверу в Discord -> Copy Server ID, нужен режим разработчика).
# Нужен, чтобы слэш-команды регистрировались мгновенно (на конкретном сервере),
# а не глобально (глобальная регистрация обновляется до часа).
GUILD_ID=

# Режим запуска: local для домашнего Docker или server для VPS.
DEPLOYMENT_MODE=local
# auto означает ngrok в local-режиме и Cloudflare Tunnel в server-режиме.
REMOTE_ACCESS_PROVIDER=auto
# Docker-профили. Для VPS используйте server,pot; локально достаточно pot.
COMPOSE_PROFILES=pot

# Порт локальной веб-панели управления (http://127.0.0.1:PORT). По умолчанию 8787.
WEB_PORT=8787
# Не публикуйте панель на 0.0.0.0: Cloudflare и ngrok подключаются без этого.
WEB_BIND_ADDRESS=127.0.0.1
# Начальная громкость на стороне бота для новых очередей: 0-200 процентов.
MUSIC_DEFAULT_VOLUME_PERCENT=100
# Максимальный размер приложенного к /play файла, байты. По умолчанию 200 МБ.
MUSIC_FILE_MAX_BYTES=209715200

# Серверный режим (Cloudflare Tunnel):
# DEPLOYMENT_MODE=server
# COMPOSE_PROFILES=server,pot
# PUBLIC_BASE_URL=https://panel.example.com
# CLOUDFLARE_TUNNEL_TOKEN=токен_из_Cloudflare_Zero_Trust
PUBLIC_BASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3

# Необязательно: https://dashboard.ngrok.com/get-started/your-authtoken
# Нужен только для кнопки «Подключить телефон»; туннель запускается по требованию.
NGROK_AUTHTOKEN=
# Необязательно: закреплённый hostname, например example.ngrok-free.app.
NGROK_DOMAIN=
# Информационный ID ресурса rd_...; для его разрешения через API нужен NGROK_API_KEY.
NGROK_DOMAIN_ID=

# Ограничения контейнеров. Для VPS с 8 GB RAM рекомендуется 5g/2g/3 CPU.
BOT_MEMORY_LIMIT=3g
BOT_MEMORY_RESERVATION=1g
BOT_CPU_LIMIT=2.0
BOT_CPU_RESERVATION=0.5
POT_MEMORY_LIMIT=512m
POT_CPU_LIMIT=0.5
CLOUDFLARED_MEMORY_LIMIT=256m
CLOUDFLARED_CPU_LIMIT=0.25

# Необязательно: автоматическая выдача YouTube PO Token для yt-dlp.
# Для Docker Compose раскомментируйте обе строки:
# COMPOSE_PROFILES=pot
# YTDLP_POT_PROVIDER_URL=http://bgutil-provider:4416
# YTDLP_PLAYER_CLIENT=mweb

# Необязательно: управление политиками истории и кэша (по умолчанию применяются значения из кода)
# После указанного TTL сообщения перемещаются в archive-таблицу (в секундах), по умолчанию 30 дней.
MESSAGE_HISTORY_TTL_MS=2592000000
# Размер батча для архивирования/очистки истории, по умолчанию 500.
MESSAGE_ARCHIVE_BATCH=500
# Лимиты аудио-кэша (по умолчанию). Дефолт: 2000 файлов, 8GB, 14 дней.
AUDIO_CACHE_MAX_FILES=2000
AUDIO_CACHE_MAX_BYTES=8589934592
AUDIO_CACHE_MAX_AGE_MS=1209600000
AUDIO_CACHE_PRUNE_BATCH=16

# Необязательно: лимиты сохранения плейлистов (по умолчанию 120 манифестов и 5000 треков).
PLAYLIST_MAX_MANIFESTS=120
PLAYLIST_MAX_TRACKS=5000
